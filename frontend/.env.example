# Copy this file to `.env.local` in frontend/ and fill it in. `.env.local` is git-ignored.
# Anything starting with NEXT_PUBLIC_ is sent to the browser, so only put PUBLIC values here.
# NEVER put the Supabase secret/service key in this file.

# Same Supabase project as the backend. Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The public "anon" key (safe for browsers). Same page as above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- optional ---------------------------------------------------------------
# Where the backend API runs. Default: http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:3000
