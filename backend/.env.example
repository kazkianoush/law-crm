# Copy this file to `.env` in backend/ and fill it in. `.env` is git-ignored: never commit it.
# Everything below comes from your own Supabase project (https://supabase.com/dashboard).

# Project URL. Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# SERVER-SIDE secret key (the "service_role" / secret key). Dashboard -> Project Settings -> API.
# It bypasses all access rules: keep it on the server, never in the frontend or in git.
SUPABASE_SECRET_KEY=

# Postgres connection used by the API through Prisma (the pooled one).
# Dashboard -> Connect -> ORMs / Prisma. Looks like:
#   postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Direct Postgres connection, used by db/apply.sh (migrations) and `prisma db pull`.
# Dashboard -> Connect -> Direct connection. Looks like:
#   postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
DIRECT_URL=

# --- optional ---------------------------------------------------------------
# Where the frontend runs, for CORS. Default: http://localhost:3001
# FRONTEND_ORIGIN=http://localhost:3001

# Password for dev accounts made by scripts/seed-members.ts and scripts/create-user.ts.
# Default if unset: see the scripts. Dev/test accounts only.
# SEED_PASSWORD=
