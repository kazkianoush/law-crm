generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Task {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  users_id    String    @db.Uuid
  title       String?
  description String?
  status      String?
  due_date    DateTime? @db.Date

  @@map("tasks")
}